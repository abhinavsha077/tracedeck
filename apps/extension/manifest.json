{
  "manifest_version": 3,
  "name": "TraceDeck",
  "version": "0.1.0",
  "description": "Capture screenshots and recordings with developer context for TraceDeck.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TraceDeck"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen",
    "storage",
    "scripting",
    "desktopCapture",
    "downloads"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_page": "options.html"
}
