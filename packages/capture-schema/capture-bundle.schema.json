{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracedeck.dev/schema/capture-bundle-v1.json",
  "title": "TraceDeck CaptureBundleV1",
  "type": "object",
  "required": ["schemaVersion", "capture", "events"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "capture": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "url": {"type": "string"},
        "createdAt": {"type": "string"},
        "durationMs": {"type": "number", "minimum": 0},
        "source": {"enum": ["extension", "recording-link", "sdk", "cli", "api", "import"]},
        "environment": {"type": "object", "additionalProperties": true},
        "metadata": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "ts"],
        "properties": {
          "type": {"type": "string"},
          "ts": {"type": "number", "minimum": 0},
          "level": {"type": "string"},
          "data": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {"type": "string"},
          "name": {"type": "string"},
          "contentType": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
